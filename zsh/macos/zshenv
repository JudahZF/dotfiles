# macOS can export an Apple/ICU locale identifier via LC_ALL, e.g.
# en-GB-u-ca-gregory-co-standard-cu-gbp-fw-mon-hc-h23-ms-uksystem-tz-gblon.
# GNU tools from Nix do not understand that form and print setlocale warnings.
export LANG="en_GB.UTF-8"
export LC_ALL="en_GB.UTF-8"

export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
export BTCA_KEY=ak_7JTBTEYW4CZ8GYKE3P8PG9A50XM0CR6B

export PATH="$HOME/.cargo/bin:$PATH"
export PNPM_HOME="$HOME/.pnpm/"
export PATH="$PNPM_HOME:$PATH"
export PATH="$HOME/.bun/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="/Applications/Ghostty.app/Contents/MacOS:$HOME/Library/Python/3.9/bin:$PATH"

# Nix
export PATH=/run/current-system/sw/bin:$HOME/.nix-profile/bin:$PATH
if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi
